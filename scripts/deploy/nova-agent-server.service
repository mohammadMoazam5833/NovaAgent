[Unit]
Description=NovaAgent agent-server (OpenHands SDK + sidecar bridge)
After=network-online.target nova-gateway.service
Wants=network-online.target

[Service]
Type=simple
User=moazemi-gc
WorkingDirectory=/home/moazemi-gc
EnvironmentFile=/home/moazemi-gc/.nova-env
Environment=PYTHONPATH=/home/moazemi-gc/OpenHands/tools
ExecStart=/home/moazemi-gc/.local/bin/agent-server --host 0.0.0.0 --port 18000 --import-modules sidecar_bridge
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
