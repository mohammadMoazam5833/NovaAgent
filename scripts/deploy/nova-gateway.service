[Unit]
Description=NovaAgent customer workspace gateway (reverse WS hub)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=moazemi-gc
WorkingDirectory=/home/moazemi-gc/OpenHands/scripts
EnvironmentFile=/home/moazemi-gc/.nova-env
ExecStart=/home/moazemi-gc/.nvm/versions/node/v24.13.0/bin/node customer-workspace-gateway.mjs
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
